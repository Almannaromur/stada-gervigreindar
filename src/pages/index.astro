---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticlePanel from '@/components/ArticlePanel.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import { getCategories, getCategory, getHomeArticles } from '@/lib/content';
import { site } from '@/site';

const categories = await getCategories();
const latest = await Promise.all((await getHomeArticles()).map(async (article) => ({ article, category: await getCategory(article) })));
---

<BaseLayout backdrop="brand">
  <div class="container">
    <section class="intro">
      <div class="lead">
        <p class="eyebrow">{site.home.eyebrow}</p>
        <h1>{site.home.title}</h1>
        <p class="lead-text">{site.home.lead}</p>
      </div>
      <div class="latest">
        <ArticlePanel title="Nýjar greinar" items={latest} />
      </div>
    </section>

    <section class="section categories" aria-labelledby="flokkar">
      <h2 id="flokkar" class="section-heading">Flokkar</h2>
      <ul>
        {
          categories.map((category) => (
            <li>
              <CategoryCard category={category} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 3rem;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(4rem, 7vw, 6rem);
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 652px);
      gap: 4rem;
    }
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    font-size: var(--body-xs);
    font-weight: 500;
  }

  .lead-text {
    max-width: 33rem;
    margin: 1.75rem 0 0;
    font-size: var(--body-lg);
    line-height: 1.4;
    letter-spacing: -0.0025em;
  }

  .categories ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 3.5rem 6px;
    margin: 2.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .categories ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .categories ul {
      gap: 1.5rem;
    }
  }
</style>
