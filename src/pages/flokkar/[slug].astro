---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import BackButton from '@/components/BackButton.astro';
import CategoryCta from '@/components/CategoryCta.astro';
import { categoryVars } from '@/lib/colors';
import { categoryArt, getArticles, getCategories, type Article, type Category } from '@/lib/content';

export async function getStaticPaths() {
  const categories = await getCategories();
  const articles = await getArticles();
  return categories.map((category, i) => ({
    params: { slug: category.id },
    props: {
      category,
      articles: articles.filter((a) => a.data.category.id === category.id),
      next: categories[(i + 1) % categories.length],
    },
  }));
}

interface Props {
  category: Category;
  articles: Article[];
  next: Category;
}

const { category, articles, next } = Astro.props;
const { name, description, color } = category.data;
---

<BaseLayout title={name} description={description} backdrop={{ art: categoryArt(category, 'hero') }} style={categoryVars(color)}>
  <div class="container">
    <header class="intro">
      <BackButton href="/" />
      <h1>{name}</h1>
      <p class="lead-text">{description}</p>
    </header>

    <section class="section split" aria-labelledby="greinar">
      <h2 id="greinar" class="section-heading">Greinar</h2>
      <div class="split-body">
        {
          articles.length > 0 ? (
            <ul class="articles">
              {articles.map((article) => (
                <li>
                  <ArticleCard article={article} category={category} excerpt />
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">Engar greinar hafa enn birst í þessum flokki.</p>
          )
        }
      </div>
    </section>

    <div class="next">
      <CategoryCta heading="Næsti flokkur" category={next} />
    </div>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 14vw, 12.75rem) clamp(3.5rem, 6vw, 5.5rem);
  }

  h1 {
    margin-top: 1.75rem;
    max-width: 50rem;
  }

  .lead-text {
    max-width: 46.5rem;
    margin: 1.25rem 0 0;
    font-size: var(--body-lg);
    line-height: 1.34;
  }

  .articles {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    margin: 0;
    padding: 2rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .next {
    margin-top: clamp(4rem, 8vw, 5.75rem);
  }
</style>
