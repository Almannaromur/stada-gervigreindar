---
import { getEntry, render } from 'astro:content';
import '@/styles/prose.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleLink from '@/components/ArticleLink.astro';
import ArticlePanel from '@/components/ArticlePanel.astro';
import BackButton from '@/components/BackButton.astro';
import Byline from '@/components/Byline.astro';
import CategoryCta from '@/components/CategoryCta.astro';
import CategoryDot from '@/components/CategoryDot.astro';
import OpinionTag from '@/components/OpinionTag.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { customArticlePages } from '@/layouts/articles';
import { categoryVars } from '@/lib/colors';
import * as contentComponents from '@/components/content';
import { categoryUrl, formatDate, getAllArticles, getArticles, getCategories, getCategory, isoDate, nextArticle, opinionCategoryId, readingPath, type Article } from '@/lib/content';

export async function getStaticPaths() {
  const path = readingPath(await getArticles(), await getCategories());
  // Drafts get a page too (for preview), but aren't part of the reading path
  return (await getAllArticles()).map((article) => ({
    params: { slug: article.id },
    props: { article, next: nextArticle(article, path) },
  }));
}

interface Props {
  article: Article;
  next?: Article;
}

const { article, next } = Astro.props;
const category = await getCategory(article);
const nextCategory = next && (await getCategory(next));
const { Content, headings } = await render(article);
const { title, description, date, draft, heimildir } = article.data;
// „Efnisyfirlit“: the article's h2 headings, then the sources. Text before the first h2
// (most articles open without one) is listed as „Inngangur“, linking to the top of the
// text; a Disclosure (e.g. „Hagsmunir“) up there doesn't count. Articles without h2s get none.
const sections = headings.filter((h) => h.depth === 2).map(({ slug, text }) => ({ slug, text: text.trim() }));
const body = article.body ?? '';
const firstHeading = body.search(/^## /m);
const intro = firstHeading > 0 && body.slice(0, firstHeading).replace(/<Disclosure\b[^>]*\/>|<Disclosure\b[\s\S]*?<\/Disclosure>/g, '').trim() !== '';
const toc =
  sections.length > 0
    ? [
        ...(intro ? [{ slug: 'inngangur', text: 'Inngangur' }] : []),
        ...sections,
        ...(heimildir.length > 0 ? [{ slug: 'heimildir', text: 'Heimildaskrá' }] : []),
      ]
    : [];
// Source text may mark titles as *italic*. When a source has no link of its own (Slóð),
// web addresses in its text become links, so a source can cite several pages.
// Every source link opens in a new tab, and says so to screen readers.
const newTab = 'target="_blank" rel="noopener"';
const newTabNote = '<span class="visually-hidden"> (opnast í nýjum flipa)</span>';
const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const linkify = (html: string) => html.replace(/https?:\/\/[^\s<"]*[^\s<".,;:!?)]/g, (url) => `<a href="${url}" ${newTab}>${url}${newTabNote}</a>`);
const sourceHtml = (s: string, links = false) => {
  const html = escapeHtml(s).replace(/\*([^*]+)\*/g, '<em>$1</em>');
  return links ? linkify(html) : html;
};
// Lets content components find images stored next to this article
Astro.locals.articleId = article.id;
Astro.locals.articleDraft = article.data.draft;
// One-off articles with a page design of their own (src/layouts/articles) use it instead
const CustomPage = customArticlePages[article.id];
// Related articles ("Tengt efni"): missing ones, the article itself and drafts are left out
// (drafts are shown when this article is a draft too, for preview)
const related = (
  await Promise.all(
    article.data.tengt.map(async (ref) => {
      const entry = await getEntry(ref);
      if (!entry || entry.id === article.id || (entry.data.draft && !draft)) return undefined;
      return { article: entry, category: await getCategory(entry) };
    }),
  )
).filter((item) => item !== undefined);
---

{
  CustomPage ? (
    <CustomPage article={article} category={category} />
  ) : (
    <BaseLayout title={title} description={description} ogType="article" style={categoryVars(category.data.color)} noindex={draft}>
      <div class="container layout">
        <div class="back"><BackButton href={categoryUrl(category)} /></div>

        <article class="article">
          {draft && <p class="draft-banner" role="status">Drög: þessi grein er ekki birt. Hún sést aðeins þeim sem hafa slóðina.</p>}
          {
            draft && category.id === opinionCategoryId && (
              <p class="draft-banner" role="note">
                Veljið flokk eftir efni greinarinnar í stað „{category.data.name}“ og hakið við „Skoðanapistill“. (Sést aðeins í drögum.)
              </p>
            )
          }
          <header>
            <p class="meta">
              <span class="tags">
                <a href={categoryUrl(category)} class="category">
                  <CategoryDot color={category.data.color} size="lg" />
                  {category.data.name}
                </a>
                {article.data.opinion && <OpinionTag link />}
              </span>
              <span class="when">
                <time datetime={isoDate(date)}>{formatDate(date)}</time>
                {/* Reading time is hidden until it's calculated better; to show it again, restore
                    this line and the readingMinutes import:
                    <span class="reading-time">{readingMinutes(article)} mín lestur</span> */}
              </span>
            </p>
            <h1>{title}</h1>
            <Byline article={article} />
          </header>

          {
            toc.length > 0 && (
              <div class="toc-inline">
                <TableOfContents items={toc} collapsible />
              </div>
            )
          }

          <div class="prose" id={intro ? 'inngangur' : undefined}>
            <Content components={{ ...contentComponents, a: ArticleLink }} />

            {
              heimildir.length > 0 && (
                <section class="sources" aria-labelledby="heimildir">
                  <h2 id="heimildir">Heimildaskrá</h2>
                  <ol>
                    {heimildir.map((h, i) => (
                      <li id={`heimild-${i + 1}`}>
                        {h.slod ? (
                          <a href={h.slod} target="_blank" rel="noopener" set:html={sourceHtml(h.texti) + newTabNote} />
                        ) : (
                          <span set:html={sourceHtml(h.texti, true)} />
                        )}
                      </li>
                    ))}
                  </ol>
                </section>
              )
            }
          </div>
        </article>

        {
          toc.length > 0 && (
            <div class="toc-side">
              <TableOfContents items={toc} />
            </div>
          )
        }

        {
          related.length > 0 && (
            <div class="related">
              <ArticlePanel title="Tengt efni" items={related} />
            </div>
          )
        }

        {
          next && nextCategory && (
            <div class="next-article">
              <ArticlePanel title="Næsta grein" items={[{ article: next, category: nextCategory }]} />
            </div>
          )
        }
      </div>

      <div class="container category-cta">
        <CategoryCta heading="Flokkur" category={category} />
      </div>
    </BaseLayout>
  )
}

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--article-width)) minmax(0, 1fr);
    column-gap: 2rem;
    padding-top: clamp(1.5rem, 5vw, 4.5rem);
  }

  .back {
    grid-column: 1;
    grid-row: 1;
  }

  .article,
  .related,
  .next-article {
    grid-column: 2;
  }

  .article {
    grid-row: 1 / span 2;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 2.5rem;
    margin-bottom: 2.75rem;
    border-bottom: 1px solid var(--color-line-soft);
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.875rem 1rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .category {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .category:hover {
    text-decoration: underline;
  }

  .draft-banner {
    margin: 0 0 1.5rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius);
    background: #ffca58;
    font-weight: 600;
  }

  /* Date and reading time: "5. október 2026 · 7 mín lestur", stacked on phones */
  .when {
    display: flex;
    flex: none;
    gap: 0.5rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .reading-time::before {
    content: '·';
    content: '·' / '';
    margin-right: 0.5rem;
  }

  @media (max-width: 39.99rem) {
    .when {
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
    }

    .reading-time::before {
      display: none;
    }
  }

  h1 {
    font-size: var(--h1);
  }

  .toc-inline {
    margin-bottom: 2.75rem;
  }

  .toc-side {
    display: none;
  }

  /* Wide screens: the contents move to the left-hand column under „Til baka“, reaching
     the article's end so the sticky list stops there. Room is left on the right for the
     hanging numerals of the fullveldi article. Narrower, the column is too slim */
  @media (min-width: 75rem) {
    .layout {
      grid-template-rows: auto 1fr;
    }

    .toc-inline {
      display: none;
    }

    .toc-side {
      display: block;
      grid-column: 1;
      grid-row: 2;
      padding: 2.5rem 2rem 0 0;
    }
  }

  .related,
  .next-article {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line-soft);
  }

  /* "Næsta grein" right after "Tengt efni": one section, no second rule */
  .related + .next-article {
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: 0;
  }

  .category-cta {
    margin-top: clamp(4rem, 8vw, 5.75rem);
  }

  @media (max-width: 63.99rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .back,
    .article,
    .related,
    .next-article {
      grid-column: 1;
      grid-row: auto;
    }

    .back {
      margin-bottom: 2rem;
    }
  }
</style>
