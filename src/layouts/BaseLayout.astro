---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Background behind the top of the page: the brand gradient, or a category's artwork */
  backdrop?: 'brand' | { art: string };
  /** Extra inline style on <body>, e.g. category colour variables */
  style?: string;
  /** Keep the page out of search engines (drafts) */
  noindex?: boolean;
}

const { title, description = site.description, ogType = 'website', backdrop, style, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const backdropArt = backdrop && backdrop !== 'brand' ? backdrop.art : undefined;
const backdropStyle = backdropArt ? `background-image: url(${backdropArt})` : undefined;
---

<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-figtree" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-roboto-serif" preload />
    {backdropArt && <link rel="preload" as="image" href={backdropArt} />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    <link rel="icon" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Link previews (same tags and image as the original site) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="is_IS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body style={style}>
    {backdrop && <div class:list={['backdrop', backdrop === 'brand' ? 'brand' : 'art']} style={backdropStyle} aria-hidden="true" />}
    <a class="skip-link" href="#main">Fara í efni</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    position: relative;
  }

  .backdrop {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    pointer-events: none;
  }

  .brand {
    height: clamp(37.5rem, 60vw, 38.625rem); /* 618px */
    background: var(--gradient-brand);
  }

  .art {
    height: clamp(37.75rem, 55vw, 49.625rem); /* 794px */
    background-size: cover;
    background-position: center top;
  }
</style>
