---
/**
 * The working definition typeset as the thread: the lead-in on its own line, then the
 * three clauses each on a ruled line, numbered 1–3 in the left margin. Nothing else.
 *
 * <FvDefinition lead="Gervigreindarfullveldi er geta samfélags til að"
 *   one="gera sér grein fyrir því á hvaða tækni það reiðir sig," two="…" three="…" />
 */
import './thread.css';

interface Props {
  lead: string;
  one: string;
  two: string;
  three: string;
}

const { lead, one, two, three } = Astro.props;
---

<div class="definition">
  <p>
    <span class="lead">{lead}</span>
    {
      [one, two, three].map((clause, i) => (
        <>
          {' '}
          <span class="clause">
            <span class="n fv-numeral" aria-hidden="true">
              {i + 1}
            </span>
            {clause}
          </span>
        </>
      ))
    }
  </p>
</div>

<style>
  .definition p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 0.95rem + 0.6vw, 1.375rem);
    font-weight: 500;
    line-height: 1.36;
    letter-spacing: -0.01em;
    hyphens: manual;
  }

  .lead,
  .clause {
    display: block;
  }

  .lead {
    padding-bottom: 0.375rem;
  }

  /* Each clause sits on its line */
  .clause {
    position: relative;
    padding: 0.75rem 0 0.5rem 2rem;
    border-bottom: 2px solid var(--cat-text);
  }

  .n {
    position: absolute;
    top: 0.75rem;
    left: 0;
    font-size: 1em;
    line-height: inherit;
  }

  /* Where the page has a margin, the numerals hang in it */
  @media (min-width: 64rem) {
    .clause {
      padding-left: 0;
    }

    .n {
      left: auto;
      right: calc(100% + var(--fv-hang));
    }
  }
</style>
