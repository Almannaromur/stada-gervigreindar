---
/**
 * The article's evaluative tool as a 2×2: what is at stake (up) against how hard
 * it is to switch (right), with the three examples from the text. The benefits
 * system gets a horizontal bar: the text scores its stakes, not its switchability.
 * No quadrant labels, on purpose.
 */
const points = [
  { label: 'Þýðingartól', x: 16, y: 16, side: 'right' },
  { label: 'Sjúkraskrárkerfi', x: 84, y: 86, side: 'left' },
];
const bar = { label: 'Ákvarðanir um bætur', from: 8, to: 92, y: 64 };
---

<figure class="matrix">
  <p class="title">Tvær spurningar um hvert kerfi</p>
  <div class="plot">
    <p class="axis y">
      <span class="axis-name">Hvað er í húfi?</span>
    </p>
    <div class="area" role="img" aria-label="Þýðingartól: lágt á báðum. Sjúkraskrárkerfi: hátt á báðum. Ákvarðanir um bætur: hátt í húfi, óljóst hve erfitt er að skipta.">
      <span class="mid h" />
      <span class="mid v" />
      <span class="tick y-hi">hátt</span>
      <span class="tick y-lo">lágt</span>
      {
        points.map((p) => (
          <span class:list={['point', p.side]} style={`left: ${p.x}%; bottom: ${p.y}%`}>
            <span class="dot" />
            <span class="label">{p.label}</span>
          </span>
        ))
      }
      <span class="range" style={`left: ${bar.from}%; right: ${100 - bar.to}%; bottom: ${bar.y}%`}>
        <span class="label">{bar.label}</span>
      </span>
    </div>
    <p class="axis x">
      <span class="tick">lágt</span>
      <span class="axis-name">Hve erfitt er að skipta?</span>
      <span class="tick">hátt</span>
    </p>
  </div>
  <figcaption>Textinn metur ekki hve erfitt er að skipta um kerfi sem undirbýr ákvarðanir um bætur; því er það sýnt sem lína.</figcaption>
</figure>

<style>
  .matrix {
    margin-inline: 0;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .title {
    margin: 0 0 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .plot {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    max-width: 34rem;
    margin-inline: auto;
  }

  .axis {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    font-weight: 600;
  }

  .axis.y {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .axis.x {
    grid-column: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .axis-name {
    color: var(--color-text);
  }

  .axis .tick {
    font-weight: 500;
  }

  .area {
    position: relative;
    aspect-ratio: 4 / 3;
    border-bottom: 2px solid var(--color-text-muted);
    border-left: 2px solid var(--color-text-muted);
  }

  .mid {
    position: absolute;
    background: repeating-linear-gradient(var(--dir, 90deg), var(--color-line-soft) 0 5px, transparent 5px 10px);
  }

  .mid.h {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .mid.v {
    --dir: 180deg;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .area .tick {
    position: absolute;
    left: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
  }

  .y-hi {
    top: 0.25rem;
  }

  .y-lo {
    bottom: 0.25rem;
  }

  .point {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translate(-0.4rem, 0.4rem);
  }

  .point.left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 0.4rem), 0.4rem);
  }

  .point .dot {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--cat-text);
  }

  .label {
    font-size: var(--body-xs);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .range {
    position: absolute;
    height: 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-base) 45%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--cat-text);
    transform: translateY(0.4rem);
  }

  .range .label {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 0.5rem;
  }

  figcaption {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    line-height: 1.5;
  }

  @media (max-width: 30rem) {
    .matrix {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
