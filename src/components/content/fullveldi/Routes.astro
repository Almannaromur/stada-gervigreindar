---
/**
 * Mynd: Tveir ásar. What is at stake (up) against what is realistic for Iceland to do
 * itself (right), as a plain x–y plot. The vertical midline runs through the top half
 * only: with little at stake the route is the same either way (buy), so the bottom is
 * one region. The routes are small labels in their regions; the examples from the text
 * are dots. Þýðingartól sits to the right: buying it is about what is at stake, not a
 * judgement on what Icelandic companies can make.
 */

const routes = [
  { key: 'with', name: 'Byggja með öðrum' },
  { key: 'own', name: 'Byggja eða stjórna sjálf' },
  { key: 'buy', name: 'Kaupa með opnum möguleikum' },
];
// Positions in % of the plot. ySm is the height on phones, where the plot is taller
// and the two labels at the top need a height each to stay clear of each other
const points = [
  { label: 'LUMI-ofurtölvan', x: 17, y: 76, ySm: 82, side: 'right' },
  { label: 'Málföng og matspróf', x: 83, y: 76, ySm: 70, side: 'left' },
  { label: 'Þýðingartól', x: 55, y: 24, ySm: 26, side: 'right' },
];
const description =
  'Mikið í húfi og ekki raunhæft eitt og sér: byggja með öðrum (LUMI-ofurtölvan). Mikið í húfi og raunhæft: byggja eða stjórna sjálf (málföng og matspróf). Lítið í húfi: kaupa með opnum möguleikum (þýðingartól).';
const pointStyle = (p: { x: number; y: number; ySm: number }) => `left: ${p.x}%; --y: ${p.y}%; --y-sm: ${p.ySm}%`;
---

<figure class="routes fv-mynd">
  <p class="title">Tveir ásar</p>
  <div class="plot">
    <p class="axis y" aria-hidden="true">
      <span class="tick">lítið</span>
      <span class="axis-name">Hvað er í húfi?</span>
      <span class="tick">mikið</span>
    </p>
    <div class="area" role="img" aria-label={description}>
      <span class="mid h"></span>
      <span class="mid v"></span>
      {routes.map((r) => <span class:list={['route', r.key]}>{r.name}</span>)}
      {
        points.map((p) => (
          <span class:list={['point', p.side]} style={pointStyle(p)}>
            <span class="dot" />
            <span class="label">{p.label}</span>
          </span>
        ))
      }
    </div>
    <p class="axis x" aria-hidden="true">
      <span class="tick">lítið</span>
      <span class="axis-name">Hvað er raunhæft að gera sjálft?</span>
      <span class="tick">mikið</span>
    </p>
  </div>
</figure>

<style>
  .routes {
    margin-inline: 0;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .plot {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    max-width: 34rem;
    margin-inline: auto;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    font-weight: 500;
    line-height: 1.3;
    hyphens: manual;
  }

  .axis-name {
    color: var(--color-text);
    font-weight: 600;
    text-align: center;
  }

  /* Read bottom to top: lítið at the foot, mikið at the head */
  .axis.y {
    align-items: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .axis.x {
    grid-column: 2;
    align-items: baseline;
    padding-top: 0.5rem;
  }

  /* The plot is a container, so the labels can be sized against its width */
  .area {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    border-bottom: 2px solid var(--color-text-muted);
    border-left: 2px solid var(--color-text-muted);
  }

  .mid {
    position: absolute;
    background: repeating-linear-gradient(var(--dir, 90deg), var(--color-line-soft) 0 5px, transparent 5px 10px);
  }

  .mid.h {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  /* Only through the top half */
  .mid.v {
    --dir: 180deg;
    top: 0;
    bottom: 50%;
    left: 50%;
    width: 1px;
  }

  /* The routes: small and quiet, in their regions */
  .route {
    position: absolute;
    max-width: 44%;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .route.with {
    top: 0.625rem;
    left: 0.75rem;
  }

  .route.own {
    top: 0.625rem;
    right: 0.75rem;
    text-align: right;
  }

  .route.buy {
    bottom: 0.625rem;
    left: 50%;
    max-width: none;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  /* Each point is an anchor with no size at its exact place; the dot is centred on it
     and the label hangs beside it, centred on the dot however many lines it takes */
  .point {
    position: absolute;
    bottom: var(--y);
    width: 0;
    height: 0;
  }

  .point .dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--cat-text);
    transform: translate(-50%, -50%);
  }

  /* A label may be as wide as the room between its dot and the centre line (the dots sit
     a sixth of the way in from each side), so at any width it wraps before it reaches
     the middle, and the two at the top never meet */
  .point .label {
    position: absolute;
    top: 0;
    left: 0.75rem;
    width: max-content;
    max-width: max(4.5rem, calc(33cqi - 1rem));
    transform: translateY(-50%);
  }

  .point.left .label {
    left: auto;
    right: 0.75rem;
    text-align: right;
  }

  .label {
    font-size: var(--body-xs);
    font-weight: 600;
    line-height: 1.2;
  }

  @media (max-width: 30rem) {
    .routes {
      padding: 1.5rem 1.25rem;
    }

    /* Taller than wide, so the top half has room for its labels */
    .area {
      aspect-ratio: 2 / 3;
    }

    .point {
      bottom: var(--y-sm);
    }

    .route {
      font-size: 0.75rem;
    }

    .route.with,
    .route.own {
      top: 0.375rem;
    }

    .route.buy {
      white-space: normal;
      text-align: center;
      max-width: 90%;
    }

    .label {
      font-size: 0.8125rem;
    }  }
</style>
