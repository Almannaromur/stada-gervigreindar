---
/**
 * Mynd: Stoðir. The three pillars, labelled above, with the three thread lines
 * running across them, always in front, and a knot at each of the nine crossings.
 *
 * Each knot opens a small popup with an example for that crossing: e11…e33, line (1–3)
 * then pillar (1–3). Until an example is written, drafts show a placeholder; in a
 * published article a knot without an example is not clickable.
 *
 * An optional description (lysing) under the title says how to read and use the
 * figure; without one, a short hint under the figure says to pick a knot.
 *
 * <FvPillars lysing="…" e11="…" />
 */
import './thread.css';
import { pillars, threadLines } from './thread';

type Key = `e${1 | 2 | 3}${1 | 2 | 3}`;
type Props = Partial<Record<Key, string>> & { lysing?: string };

const props = Astro.props;
const lysing = (props.lysing ?? '').trim();
const draft = Astro.locals.articleDraft ?? false;
const crossings = threadLines.flatMap((line, i) =>
  pillars.map((pillar, j) => {
    const example = (props[`e${i + 1}${j + 1}` as Key] ?? '').trim();
    return { i, j, line, pillar, example, id: `fv-kross-${i + 1}${j + 1}`, open: Boolean(example) || draft };
  }),
);
const anyOpen = crossings.some((c) => c.open);
---

<figure class="pillars fv-mynd">
  <p class="title">Stoðir</p>
  {lysing && <p class="intro">{lysing}</p>}
  <div class="grid">
    {pillars.map((p, j) => <span class="pillar-name" style={`grid-column: ${j + 2}`}>{p}</span>)}
    {pillars.map((_, j) => <span class="pillar" style={`grid-column: ${j + 2}`} aria-hidden="true" />)}
    {
      threadLines.map((l, i) => (
        <span class="line-name" style={`grid-row: ${i + 2}`}>
          <span class="n fv-numeral">{i + 1}</span>
          <span class="line-label">{l}</span>
        </span>
      ))
    }
    {threadLines.map((_, i) => <span class="thread" style={`grid-row: ${i + 2}`} aria-hidden="true" />)}
    {
      crossings.map((c) => {
        const cell = `grid-row: ${c.i + 2}; grid-column: ${c.j + 2}`;
        return (
          <>
            {c.open ? (
              <button type="button" class="knot" style={cell} popovertarget={c.id} aria-label={`Dæmi: ${c.i + 1} ${c.line}, ${c.pillar}`} data-fv-knot>
                <span class="dot" aria-hidden="true" />
              </button>
            ) : (
              <span class="knot" style={cell} aria-hidden="true">
                <span class="dot" />
              </span>
            )}
          </>
        );
      })
    }
  </div>
  <p class="line-legend" aria-hidden="true">
    {
      threadLines.map((l, i) => (
        <span>
          <span class="fv-numeral">{i + 1}</span> {l}
        </span>
      ))
    }
  </p>
  {anyOpen && !lysing && <figcaption>Veldu punkt til að sjá dæmi.</figcaption>}
  {
    crossings
      .filter((c) => c.open)
      .map((c) => (
        <div class="pop" id={c.id} popover>
          <p class="pop-pillar">{c.pillar}</p>
          <p class="pop-line">{c.line}</p>
          <p class:list={['pop-body', { placeholder: !c.example }]}>{c.example || 'Dæmi kemur hér.'}</p>
        </div>
      ))
  }
</figure>

<script>
  // Place each popup under its knot (above it if there is no room), with its pointer at
  // the knot. Without this it opens in the middle of the screen. It closes on Escape,
  // a click outside or a second click on the knot.
  //
  // The popup is placed in `beforetoggle`, before it is shown, so it never appears
  // somewhere else first. It is still hidden then, so it is measured with a quick,
  // invisible display. While it is open it moves with its knot, and closes when the knot
  // scrolls under the sticky site header or off the bottom of the screen.
  const header = document.querySelector('[data-site-header]');
  const visibleTop = () => Math.max(0, header?.getBoundingClientRect().bottom ?? 0);

  for (const knot of document.querySelectorAll<HTMLButtonElement>('[data-fv-knot]')) {
    const pop = document.getElementById(knot.getAttribute('popovertarget') ?? '');
    if (!pop) continue;
    const edge = 12;
    const gap = 6;

    // The side (below or above the knot) is chosen when it opens and kept while scrolling
    const place = (chooseSide: boolean) => {
      const r = knot.getBoundingClientRect();
      const { clientWidth: width, clientHeight: height } = document.documentElement;
      const center = r.left + r.width / 2;
      const left = Math.max(edge, Math.min(center - pop.offsetWidth / 2, width - pop.offsetWidth - edge));
      if (chooseSide) {
        const fitsBelow = r.bottom + gap + pop.offsetHeight <= height - edge;
        const fitsAbove = r.top - gap - pop.offsetHeight >= visibleTop() + edge;
        pop.dataset.side = fitsBelow || !fitsAbove ? 'below' : 'above';
      }
      pop.style.transform = 'none';
      pop.style.left = `${left}px`;
      pop.style.top = `${pop.dataset.side === 'above' ? r.top - pop.offsetHeight - gap : r.bottom + gap}px`;
      pop.style.setProperty('--pointer', `${center - left}px`);
    };

    // Close once the knot, or a popup above it, reaches the header, or the knot leaves the screen
    const follow = () => {
      const r = knot.getBoundingClientRect();
      const top = visibleTop();
      const popupTop = pop.dataset.side === 'above' ? r.top - pop.offsetHeight - gap : r.bottom + gap;
      if (r.bottom < top || popupTop < top || r.top > document.documentElement.clientHeight) pop.hidePopover();
      else place(false);
    };

    pop.addEventListener('beforetoggle', (e) => {
      const open = (e as ToggleEvent).newState === 'open';
      knot.classList.toggle('is-open', open);
      if (!open) return;
      pop.style.display = 'block';
      pop.style.visibility = 'hidden';
      place(true);
      pop.style.removeProperty('display');
      pop.style.removeProperty('visibility');
    });
    pop.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState === 'open') {
        addEventListener('scroll', follow, { passive: true });
        addEventListener('resize', follow);
      } else {
        removeEventListener('scroll', follow);
        removeEventListener('resize', follow);
      }
    });
  }
</script>

<style>
  .pillars {
    --pillar: color-mix(in srgb, var(--cat-base) 32%, var(--color-bg));
    --pw: 1.5rem; /* pillar width */
    --tw: 2px; /* thread width */
    margin-inline: 0;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* The description: under the title, before the figure */
  .intro {
    margin: -0.625rem 0 1.75rem;
    color: var(--color-text-muted);
    font-size: var(--body-sm);
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: 10.5rem repeat(3, minmax(0, 1fr));
    grid-template-rows: auto repeat(3, minmax(3.75rem, auto));
    max-width: 34rem;
    margin-inline: auto;
  }

  .pillar-name {
    grid-row: 1;
    align-self: end;
    justify-self: center;
    max-width: 6.5rem;
    padding: 0 0.25rem 1.25rem;
    font-size: var(--body-xs);
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    hyphens: manual;
  }

  .pillar {
    z-index: 0;
    grid-row: 2 / -1;
    justify-self: center;
    width: var(--pw);
    margin-block: -0.875rem;
    border-radius: 999px;
    background: var(--pillar);
  }

  .line-name {
    grid-column: 1;
    align-self: center;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-right: 1rem;
    font-size: var(--body-sm);
    font-weight: 600;
    line-height: 1.25;
    hyphens: manual;
  }

  .line-name .n {
    flex: none;
    font-size: var(--h5);
  }

  /* The threads run in front of the pillars */
  .thread {
    z-index: 2;
    grid-column: 2 / -1;
    align-self: center;
    height: var(--tw);
    border-radius: 2px;
    background: var(--cat-text);
  }

  /* Knots: buttons where there is an example to show */
  .knot {
    z-index: 3;
    place-self: center;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
  }

  button.knot {
    cursor: pointer;
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--cat-text);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  button.knot:hover .dot,
  button.knot:focus-visible .dot,
  button.knot.is-open .dot {
    transform: scale(1.25);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--cat-base) 55%, transparent);
  }

  button.knot:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  figcaption {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    line-height: 1.5;
    text-align: center;
  }

  /* The popup: a plain card with a small pointer at its knot. In the middle of the
     screen until the script places it. */
  .pop {
    --pop-border: color-mix(in srgb, var(--color-text) 14%, transparent);
    position: fixed;
    inset: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(17rem, calc(100vw - 1.5rem));
    margin: 0;
    padding: 1rem 1.125rem 1.125rem;
    overflow: visible;
    border: 1px solid var(--pop-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: 0 12px 32px -14px rgb(61 42 39 / 0.3);
    color: var(--color-text);
    font-size: var(--body-xs);
    line-height: 1.45;
    transition: opacity 0.15s ease;
  }

  /* Fades in where it opens */
  @starting-style {
    .pop:popover-open {
      opacity: 0;
    }
  }

  /* The pointer: a small square turned on its corner, half hidden behind the card */
  .pop[data-side]::before {
    content: '';
    position: absolute;
    left: calc(var(--pointer, 50%) - 5px);
    width: 10px;
    height: 10px;
    border: 1px solid var(--pop-border);
    background: var(--color-bg);
    transform: rotate(45deg);
  }

  .pop[data-side='below']::before {
    top: -6px;
    border-right: 0;
    border-bottom: 0;
  }

  .pop[data-side='above']::before {
    bottom: -6px;
    border-top: 0;
    border-left: 0;
  }

  .pop p {
    margin: 0;
  }

  /* A small label for the pillar, the line in bold, then the example */
  .pop .pop-pillar {
    color: var(--cat-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pop .pop-line {
    margin-top: 0.125rem;
    font-size: var(--body-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .pop .pop-body {
    margin-top: 0.5rem;
    font-size: var(--body-sm);
    line-height: 1.5;
  }

  .pop .placeholder {
    color: var(--color-text-muted);
  }

  /* Phones: the line labels move under the figure, the numerals stay at the lines */
  .line-legend {
    display: none;
  }

  @media (max-width: 40rem) {
    .pillars {
      --pw: 1.25rem;
      padding: 1.5rem 1.25rem;
    }

    .grid {
      grid-template-columns: 1.75rem repeat(3, minmax(0, 1fr));
      grid-template-rows: auto repeat(3, 3.25rem);
    }

    .pillar-name {
      padding-bottom: 1.125rem;
      font-size: 0.8125rem;
      overflow-wrap: normal;
    }

    .line-name {
      padding-right: 0.5rem;
    }

    /* Hidden from view only: screen readers still get the label at its line */
    .line-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .line-legend {
      display: grid;
      gap: 0.25rem;
      margin: 1.5rem 0 0;
      font-size: var(--body-xs);
      font-weight: 600;
      line-height: 1.35;
    }

    .line-legend .fv-numeral {
      display: inline-block;
      width: 1.25rem;
      font-size: var(--body-sm);
    }

    figcaption {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .pop {
      transition: none;
    }
  }

  @media print {
    figcaption {
      display: none;
    }
  }
</style>
