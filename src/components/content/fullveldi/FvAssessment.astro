---
/**
 * Mynd: Matsspjald. The three questions of the assessment, numbered, each with a
 * short gloss, and at the foot the three possible answers: ○ liggur ekki fyrir,
 * ◐ að hluta, ● liggur fyrir. An outline to use, not a form: nothing to click.
 *
 * <FvAssessment q1="Vitum við…?" g1="Hér þarf að…" q2="…" g2="…" q3="…" g3="…" />
 */
import './thread.css';

interface Props {
  q1: string;
  g1?: string;
  q2: string;
  g2?: string;
  q3: string;
  g3?: string;
}

const { q1, g1, q2, g2, q3, g3 } = Astro.props;
const rows = [
  { q: q1, g: g1 },
  { q: q2, g: g2 },
  { q: q3, g: g3 },
];
const answers = [
  { value: 'none', label: 'Liggur ekki fyrir' },
  { value: 'half', label: 'Að hluta' },
  { value: 'full', label: 'Liggur fyrir' },
];
---

<figure class="assessment fv-mynd">
  <p class="title">Matsspjald</p>
  <ol class="rows">
    {
      rows.map((r, i) => (
        <li class="row">
          <span class="n fv-numeral" aria-hidden="true">
            {i + 1}
          </span>
          <div class="text">
            <p class="q">{r.q}</p>
            {r.g && <p class="gloss">{r.g}</p>}
          </div>
        </li>
      ))
    }
  </ol>
  <div class="answers">
    <p class="answers-label">Svarmöguleikar</p>
    <ul class="answer-list">
      {
        answers.map((a) => (
          <li class="answer">
            <span class:list={['sym', a.value]} aria-hidden="true" />
            {a.label}
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  .assessment {
    margin-inline: 0;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .title {
    margin: 0 0 0.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* The questions, numbered, with quiet lines between them */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: 1rem;
    margin: 0;
    padding: 1rem 0;
  }

  .row + .row {
    border-top: 1px solid var(--color-line-soft);
  }

  .n {
    font-size: var(--h5);
    line-height: 1.3;
  }

  .text p {
    margin: 0;
  }

  .q {
    font-size: var(--body-sm);
    font-weight: 600;
    line-height: 1.35;
  }

  .text .gloss {
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    line-height: 1.5;
  }

  /* The possible answers, once, at the foot */
  .answers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line-soft);
    font-size: var(--body-xs);
    line-height: 1.4;
  }

  .answers-label {
    margin: 0;
    color: var(--color-text-muted);
  }

  .answer-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .answer {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-weight: 600;
  }

  /* ○ ◐ ● */
  .sym {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border: 1.5px solid var(--cat-text);
    border-radius: 50%;
  }

  .sym.half {
    background: linear-gradient(90deg, var(--cat-text) 50%, transparent 50%);
  }

  .sym.full {
    background: var(--cat-text);
  }

  @media (max-width: 40rem) {
    .assessment {
      padding: 1.5rem 1.25rem;
    }

    .row {
      grid-template-columns: 1.25rem minmax(0, 1fr);
      column-gap: 0.75rem;
    }

    /* The label above, the answers one under the other, rather than two and one */
    .answers {
      flex-direction: column;
      align-items: flex-start;
    }

    .answer-list {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
