---
/**
 * A typographic card for "Hvað er gervigreindarfullveldi?": a serif
 * title under a rule, with a mark (the three claims) or an icon (the country
 * cases) in a column beside it, and optionally a small label above the title.
 *
 * <FvCard title="Staðsetning er ekki það sama og aðgangur" mark="stadsetning">…</FvCard>
 * <FvCard title="Eistland tryggir samfellu" kicker="Eistland" icon="shield-check">…</FvCard>
 */
import FvMark from './FvMark.astro';
import { boxIcons, iconViewBox, type BoxIcon } from '@/lib/icons';

interface Props {
  title: string;
  /** Small label above the title */
  kicker?: string;
  mark?: '' | 'stadsetning' | 'adgangur' | 'samningur';
  /** Icon in the side column (src/lib/icons.ts), when there is no mark */
  icon?: BoxIcon | '';
  /** Heading level of the title: 4 for cards under a subheading (h3) */
  level?: 3 | 4 | '3' | '4';
}

const { title, kicker, mark = '', icon = '', level = 3 } = Astro.props;
const Heading = `h${Number(level) === 4 ? 4 : 3}` as 'h3' | 'h4';
const iconSvg = !mark && icon ? boxIcons[icon as BoxIcon]?.svg : undefined;
---

<section class:list={['card', { 'has-mark': mark || iconSvg }]}>
  {mark === 'stadsetning' && <FvMark kind="rings" highlight={1} class="card-mark" />}
  {mark === 'adgangur' && <FvMark kind="rings" highlight={2} class="card-mark" />}
  {mark === 'samningur' && <FvMark kind="nested" class="card-mark" />}
  {iconSvg && <svg class="card-icon" viewBox={iconViewBox(icon as BoxIcon)} fill="currentColor" aria-hidden="true" focusable="false" set:html={iconSvg} />}
  <div class="content">
    {kicker && <p class="kicker">{kicker}</p>}
    <Heading class="title">{title}</Heading>
    <div class="body"><slot /></div>
  </div>
</section>

<style>
  .card {
    padding-top: 1.25rem;
    border-top: 2px solid var(--cat-base);
  }

  .has-mark {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    column-gap: 1.25rem;
  }

  .card :global(.card-mark) {
    width: 4rem;
    margin-top: 0.3rem;
  }

  .card-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--cat-text);
  }

  .kicker {
    margin: 0 0 0.35rem;
    color: var(--cat-text);
    font-size: var(--body-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    margin: 0 0 0.625rem;
    font-family: var(--font-serif);
    font-size: var(--h5);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.0125em;
  }

  .body {
    font-size: 0.95em;
  }

  .body > :global(*) {
    margin: 0;
  }

  .body > :global(* + *) {
    margin-top: 1em;
  }

  /* Cards that follow each other */
  :global(.prose > .card + .card) {
    margin-top: 2rem !important;
  }

  @media (max-width: 30rem) {
    .has-mark {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      column-gap: 0.875rem;
    }

    .card :global(.card-mark) {
      width: 2.75rem;
    }

    .card-icon {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
