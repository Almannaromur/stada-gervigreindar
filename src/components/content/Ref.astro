---
/**
 * Reference to a source in the article's "Heimildir" list: <Ref n={3} /> → [3]
 */
interface Props {
  n: number | string;
}

const n = Number(Astro.props.n);
---

<sup class="ref"><a href={`#heimild-${n}`} aria-label={`Heimild ${n}`}>{n}</a></sup>

<style>
  .ref {
    position: relative;
    top: -0.5em;
    vertical-align: baseline;
    line-height: 0;
  }

  a {
    padding-inline: 0.1em;
    color: var(--cat-text);
    font-size: 0.72em;
    font-weight: 600;
    text-decoration: none;
  }

  a::before {
    content: '[';
  }

  a::after {
    content: ']';
  }

  a:hover {
    text-decoration: underline;
  }
</style>
