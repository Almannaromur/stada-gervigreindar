---
/**
 * A chart, diagram or table image with an optional numbered caption.
 * The caption is the content between the tags.
 *
 * <Figure image="mynd-1.png" alt="…" kind="Mynd" number="1.1" title="…">
 *   Caption text<Ref n={3} />
 * </Figure>
 */
import { Image } from 'astro:assets';
import { resolveImage } from '@/lib/images';

interface Props {
  image: string;
  alt?: string;
  kind?: 'Mynd' | 'Tafla';
  number?: string;
  title?: string;
}

const { image, alt = '', kind = 'Mynd', number, title } = Astro.props;
const src = resolveImage(image, Astro.locals.articleId);
const hasCaption = Astro.slots.has('default') || number;
---

<figure class="figure">
  {title && <p class="title">{title}</p>}
  <div class="media">
    {typeof src === 'string' ? <img src={src} alt={alt} loading="lazy" /> : <Image src={src} alt={alt} />}
  </div>
  {
    hasCaption && (
      <figcaption>
        {number && <span class="label">{kind} {number}</span>}
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin-inline: 0;
  }

  .title {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    line-height: 1.5;
  }

  figcaption :global(p) {
    display: inline;
    margin: 0;
  }

  .label {
    margin-right: 0.5rem;
    color: var(--color-text);
    font-weight: 600;
  }
</style>
