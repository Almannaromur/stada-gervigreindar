---
/**
 * Top of the Gallup article: category, title, lead (the content) and byline on the brand
 * gradient, with the line pattern on the right. Title, category, author and date come
 * from the article's fields.
 *
 * <GallupHero>Ný könnun Gallup fyrir Almannaróm sýnir…</GallupHero>
 */
import './gallup.css';
import { getEntry } from 'astro:content';
import { categoryUrl, formatDate, isoDate } from '@/lib/content';

const article = Astro.locals.articleId ? await getEntry('greinar', Astro.locals.articleId) : undefined;
const category = article && (await getEntry(article.data.category));
const author = article && (await getEntry(article.data.author));
// The pattern: nine wavy lines, and squares [x, y, size] scattered over them
const lines = [
  'M40 -10 C10 140,69 300,22 470',
  'M110 -10 C78 140,133 300,92 470',
  'M180 -10 C158 140,234 300,162 470',
  'M250 -10 C227 140,293 300,232 470',
  'M320 -10 C282 140,343 300,302 470',
  'M390 -10 C341 140,442 300,372 470',
  'M460 -10 C434 140,482 300,442 470',
  'M530 -10 C508 140,577 300,512 470',
  'M600 -10 C567 140,624 300,582 470',
];
const squares = [
  [102, 292, 21], [70, 299, 27], [238, 332, 17], [416, 35, 15], [57, 295, 21], [306, 224, 18], [563, 70, 18], [195, 62, 23],
  [391, 59, 20], [71, 326, 16], [518, 358, 20], [331, 248, 27], [380, 163, 28], [194, 367, 21], [93, 304, 21], [547, 263, 23],
  [469, 157, 24], [130, 272, 16], [178, 397, 27], [165, 260, 24], [50, 352, 27], [581, 303, 16], [358, 365, 24], [518, 306, 25],
  [80, 57, 28], [495, 366, 22],
];
---

<div class="g-hero">
  <svg class="pattern" viewBox="0 0 620 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    {lines.map((d) => <path d={d} fill="none" stroke="#FFFFFF" stroke-width="1.6" />)}
    {squares.map(([x, y, s]) => <rect x={x} y={y} width={s} height={s} fill="none" stroke="#6CC3D8" stroke-width="1.4" />)}
  </svg>
  <div class="inner">
    {article?.data.draft && <p class="draft" role="status">Drög: þessi grein er ekki birt. Hún sést aðeins þeim sem hafa slóðina.</p>}
    {category && <a class="tag" href={categoryUrl(category)}>{category.data.name}</a>}
    <h1>{article?.data.title}</h1>
    <div class="lead"><slot /></div>
    {
      article && (
        <p class="byline">
          {author && <span class="who">{author.data.name}</span>}
          <span class="when">
            <time datetime={isoDate(article.data.date)}>{formatDate(article.data.date)}</time>
          </span>
        </p>
      )
    }
  </div>
</div>
