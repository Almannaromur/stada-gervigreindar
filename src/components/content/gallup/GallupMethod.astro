---
/**
 * Gallup article: a card with a button that opens the content in a dialog. The dialog also
 * opens straight from the address …#<id>; Esc, the X or a click outside it closes it.
 *
 * <GallupMethod text="Nánar um gögnin…" button="Opna aðferðafræði">…the methodology…</GallupMethod>
 */
import './gallup.css';

interface Props {
  /** Title of the dialog */
  title?: string;
  /** Text on the card, beside the button */
  text?: string;
  button?: string;
  /** The dialog's address, …#<id> */
  id?: string;
}

const { title = 'Aðferðafræði', text, button = 'Opna aðferðafræði', id = 'adferdafraedi' } = Astro.props;
---

<div class="g-method">
  <div class="card">
    {text && <p>{text}</p>}
    <button class="open" type="button" data-g-open={id} aria-haspopup="dialog" aria-controls={id}>
      <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false">
        <path
          d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"
        />
      </svg>
      {button}
    </button>
  </div>
  <dialog id={id} aria-labelledby={`${id}-titill`}>
    <div class="inner">
      <button class="close" type="button" aria-label={`Loka ${title.toLocaleLowerCase('is')}`}>
        <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false">
          <path
            d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"
          />
        </svg>
      </button>
      <h2 id={`${id}-titill`}>{title}</h2>
      <slot />
    </div>
  </dialog>
</div>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('.g-method dialog')) {
    const hash = `#${dialog.id}`;
    let lastFocus: HTMLElement | null = null;
    const open = () => {
      lastFocus = document.activeElement as HTMLElement | null;
      dialog.showModal();
      if (location.hash !== hash) history.replaceState(null, '', hash);
    };
    document.querySelector(`[data-g-open="${dialog.id}"]`)?.addEventListener('click', open);
    dialog.querySelector('.close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (location.hash === hash) history.replaceState(null, '', location.pathname + location.search);
      lastFocus?.focus();
    });
    if (location.hash === hash) open();
  }
</script>
