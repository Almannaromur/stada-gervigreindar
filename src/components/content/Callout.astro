---
/**
 * Highlighted box, e.g. "Staðan í dag" / "Markmið".
 *
 * <Callout label="Markmið" title="Vöxtur með gervigreind">
 *   Text…
 *   <Stat>25% aukning VLF á næstu 5 árum</Stat>
 * </Callout>
 */
interface Props {
  label: string;
  title?: string;
}

const { label, title } = Astro.props;
const variant = /markmi/i.test(label) ? 'goal' : 'status';
---

<aside class:list={['callout', variant]}>
  <p class="label">{label}</p>
  {title && <p class="title">{title}</p>}
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--cat-base) 18%, var(--color-bg));
    font-size: var(--body-sm);
    line-height: 1.5;
  }


  /* Label as a badge: green for goals, grey for the current status */
  .label {
    display: inline-block;
    margin: 0 0 0.875rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: #c6c6c6;
    font-size: var(--body-xs);
    font-weight: 700;
    line-height: 1.2;
  }

  .goal .label {
    background: #6ce459;
  }

  .title {
    margin: 0 0 0.5rem;
    font-size: var(--body-md);
    font-weight: 600;
    line-height: 1.3;
  }

  .body > :global(*) {
    margin: 0;
  }

  .body > :global(* + *) {
    margin-top: 0.75rem;
  }

  /* Callouts that follow each other read as one group */
  :global(.callout + .callout) {
    margin-top: var(--gap-tight) !important;
  }
</style>
