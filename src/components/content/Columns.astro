---
/**
 * Boxes side by side: two columns on wide screens, one on phones.
 *
 * <Columns>
 *   <Box title="Þróunaraðili">…</Box>
 *   <Box title="Notandi" tone="neutral">…</Box>
 * </Columns>
 */
---

<div class="columns"><slot /></div>

<style>
  .columns {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The grid gap spaces the boxes; cancel the stacking rule for boxes in a row */
  .columns > :global(.box + .box) {
    margin-top: 0 !important;
  }

  .columns > :global(.box) {
    padding: 1.5rem;
  }
</style>
