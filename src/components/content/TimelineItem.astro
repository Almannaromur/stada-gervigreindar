---
/**
 * One event in a Timeline. The details go between the tags.
 *
 * <TimelineItem date="2. desember 2027" region="ESB" title="Áhættusömu kerfin"
 *   affects="Þróunaraðila, Notendur áhættusamra kerfa"
 *   shift="Átti að gilda frá ~~2. ágúst 2026~~ en var fært til 2. desember 2027.">
 *   Strangasti hluti reglugerðarinnar tekur gildi…
 * </TimelineItem>
 */
interface Props {
  date: string;
  /** Chip after the date, e.g. "ESB" or "Ísland" */
  region?: string;
  title: string;
  /** Already happened: shown with a tick */
  done?: boolean;
  /** Who it affects, comma separated */
  affects?: string;
  /** A note about a changed date; ~~text~~ is shown struck through */
  shift?: string;
}

const { date, region, title, done = false, affects, shift } = Astro.props;
const tags = (affects ?? '')
  .split(',')
  .map((s) => s.trim())
  .filter(Boolean);
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const shiftHtml = shift ? escape(shift).replace(/~~(.+?)~~/g, '<s>$1</s>') : undefined;
const regionKey = region === 'Ísland' ? 'is' : 'eu';
---

<li class:list={['item', { done }]}>
  <p class="when">
    {date}{region && ' '}
    {region && <span class:list={['chip', regionKey]}>{region}</span>}
  </p>
  <p class="what">{title}</p>
  <div class="details"><slot /></div>
  {shiftHtml && <p class="shift" set:html={shiftHtml} />}
  {
    tags.length > 0 && (
      <p class="affects">
        <span class="affects-label">Snertir</span>
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </p>
    )
  }
</li>

<style>
  .item {
    position: relative;
    margin-left: 0.5rem;
    padding: 0 0 1.75rem 1.75rem;
    border-left: 2px solid var(--color-line-soft);
  }

  /* After the "today" divider: the line in the category colour */
  :global(.today) ~ .item {
    border-left-color: var(--cat-base);
  }

  .item:last-child {
    padding-bottom: 0.25rem;
  }

  /* Dot on the line; filled with a tick when the event has happened */
  .item::before {
    content: '';
    position: absolute;
    top: 0.1rem;
    left: calc(-0.5rem - 1px);
    width: 1rem;
    height: 1rem;
    box-sizing: border-box;
    border: 2px solid var(--cat-base);
    border-radius: 50%;
    background: var(--color-bg);
  }

  .done::before {
    border-color: var(--cat-text);
    background: var(--cat-text);
  }

  .done::after {
    content: '\2713';
    position: absolute;
    top: 0.1rem;
    left: calc(-0.5rem - 1px);
    width: 1rem;
    color: var(--color-white);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1rem;
    text-align: center;
  }

  .item p,
  .details > :global(*) {
    margin: 0;
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    font-weight: 600;
  }

  .chip,
  .tag {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .chip.eu {
    background: color-mix(in srgb, var(--cat-base) 35%, var(--color-bg));
  }

  .chip.is {
    background: var(--color-brand-yellow);
  }

  .item .what {
    margin-top: 0.2rem;
    font-family: var(--font-serif);
    font-size: var(--body-md);
    font-weight: 500;
    line-height: 1.32;
  }

  .details {
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .details > :global(* + *) {
    margin-top: 0.5em;
  }

  .item .shift {
    margin-top: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--cat-base) 18%, var(--color-bg));
    font-size: var(--body-xs);
    line-height: 1.5;
  }

  .shift :global(s) {
    color: var(--color-text-muted);
  }

  .item .affects {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.625rem;
  }

  .affects-label {
    margin-right: 0.125rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tag {
    background: var(--color-surface);
  }
</style>
