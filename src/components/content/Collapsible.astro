---
/**
 * A box that opens on click, for supplementary material or a long list.
 * Native <details>, so it works without JavaScript.
 *
 * <Collapsible label="Aukaefni" title="Meginreglur UNESCO í fimmtán liðum">
 *   Inngangstexti…
 *
 *   1. **Vernd mannréttinda** *Protection of human rights*
 *
 *      Skýring…
 * </Collapsible>
 *
 * Numbered lists inside get large numerals; italics straight after the bold name
 * (e.g. the English term) are shown small and grey.
 */
import Icon from '../Icon.astro';

interface Props {
  /** Small label above the title */
  label?: string;
  title: string;
  /** Heading level for the title */
  level?: 3 | 4 | '3' | '4';
}

const { label = 'Aukaefni', title, level = 3 } = Astro.props;
const Heading = `h${Number(level)}` as 'h3' | 'h4';
---

<details class="collapsible">
  <summary>
    <span class="text">
      {label && <span class="label">{label}</span>}
      <Heading class="title">{title}</Heading>
    </span>
    <Icon name="chevron-down" class="chevron" />
  </summary>
  <div class="body"><slot /></div>
</details>

<style>
  .collapsible {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 2rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--color-hover);
  }

  .collapsible[open] summary {
    border-bottom: 1px solid var(--color-line-soft);
  }

  .text {
    display: block;
  }

  .label {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--cat-text);
    font-size: var(--body-xs);
    font-weight: 600;
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--h5);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.0125em;
  }

  summary :global(.chevron) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--cat-text);
    transition: transform 0.2s ease;
  }

  .collapsible[open] summary :global(.chevron) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    summary :global(.chevron) {
      transition: none;
    }
  }

  .body {
    padding: 1.5rem 2rem 2rem;
    font-size: 0.9em;
    line-height: 1.55;
  }

  .body > :global(*) {
    margin: 0;
  }

  .body > :global(* + *) {
    margin-top: 1em;
  }

  /* Numbered list: large numerals, a thin line between items */
  .body :global(ol) {
    padding: 0;
    list-style: none;
    counter-reset: item;
  }

  .body :global(ol > li) {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    margin: 0;
    padding: 0.875rem 0;
    border-top: 1px solid var(--color-line-soft);
    counter-increment: item;
  }

  .body :global(ol > li:first-child) {
    border-top: 0;
  }

  .body :global(ol > li)::before {
    content: counter(item);
    grid-row: 1 / span 9;
    color: var(--cat-text);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .body :global(ol > li > *) {
    grid-column: 2;
    margin: 0;
  }

  .body :global(ol > li > * + *) {
    margin-top: 0.2em;
  }

  /* The English term after the bold name */
  .body :global(li > p:first-child strong + em) {
    margin-left: 0.25em;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    font-style: normal;
    font-weight: 600;
  }

  @media (max-width: 30rem) {
    summary,
    .body {
      padding-inline: 1.25rem;
    }

    .body :global(ol > li) {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      column-gap: 0.75rem;
    }
  }
</style>
