---
/** One bar in a BarChart: <Bar label="2026" value={69} />, or <Bar … highlight /> for full colour */
interface Props {
  label: string;
  value: number;
  /** Full colour; when no bar in the chart has it, the last bar is in full colour */
  highlight?: boolean;
}

const { label, value, highlight = false } = Astro.props;
---

<div class:list={['bar', { highlight }]}>
  <span class="label">{label}</span>
  <span class="track" aria-hidden="true"><span class="fill" style={`--value: ${Number(value) || 0}`}></span></span>
  <span class="value">{Number(value).toLocaleString('is-IS')}</span>
</div>

<style>
  /* The label, bar and value take part in the chart's grid (BarChart), so all bars line up */
  .bar {
    display: contents;
  }

  .label {
    font-size: var(--body-sm);
    font-weight: 600;
  }

  .track {
    height: 1.75rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-base) 18%, var(--color-bg));
  }

  .fill {
    display: block;
    width: min(100%, calc(var(--value) / var(--max) * 100%));
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, var(--cat-base) 50%, var(--color-bg));
  }

  /* Full colour: the highlighted bars, or the last bar when none is highlighted */
  .highlight .fill,
  .bar:last-child .fill {
    background: var(--cat-base);
  }

  :global(.bars:has(.highlight)) .bar:last-child:not(.highlight) .fill {
    background: color-mix(in srgb, var(--cat-base) 50%, var(--color-bg));
  }

  .value {
    color: var(--cat-text);
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  .value::after {
    content: var(--unit);
  }
</style>
