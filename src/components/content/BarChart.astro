---
/**
 * Horizontal bar chart. Each bar is a <Bar>; widths are relative to `max`, and
 * the last bar is drawn in the full category colour.
 *
 * <BarChart title="Notkun gervigreindar í lögfræðiþjónustu" caption="Heimild: 8am, 2026 Legal Industry Report.">
 *   <Bar label="2025" value={31} />
 *   <Bar label="2026" value={69} />
 * </BarChart>
 */
interface Props {
  title?: string;
  /** Explanation and source, under the bars */
  caption?: string;
  /** Value of a full-width bar */
  max?: number;
  /** Shown after each value */
  unit?: string;
}

const { title, caption, max = 100, unit = '%' } = Astro.props;
---

<figure class="bar-chart" style={`--max: ${max || 100}; --unit: ${JSON.stringify(unit ?? '')}`}>
  {title && <figcaption class="title">{title}</figcaption>}
  <div class="bars"><slot /></div>
  {caption && <p class="caption">{caption}</p>}
</figure>

<style>
  .bar-chart {
    margin-inline: 0;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .title {
    margin-bottom: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .bars {
    display: grid;
    gap: 0.75rem;
  }

  .caption {
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: var(--body-xs);
    line-height: 1.5;
  }
</style>
