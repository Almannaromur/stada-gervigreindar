---
/**
 * Tinted box for a self-contained piece of content: an example, a scenario,
 * a question, a company or a tool. Tinted with the article's category colour.
 *
 * <Box title="Ókeypis aðgangur að mállíkani">…</Box>
 * <Box title="Sérstök áskorun: Apple" logo="/src/content/greinar/<grein>/apple.svg" logoAlt="Apple" rating={1}>…</Box>
 * <Box tone="neutral">…</Box>          grey instead of the category colour
 * <Box tone="outline">…</Box>          outline only
 * <Box title="Andlitsgreiningar" icon="user-focus">…</Box>           icon next to the title (src/lib/icons.ts)
 * <Box title="Frumvarp á Alþingi" chip="Haust 2027">…</Box>          small label above the title
 * <Box title="Bönnuð notkun" tone="red" chip="Tók gildi 2025">…</Box> coloured header (red, orange, yellow, green)
 * <Box title="Gagnaöryggi" icon="number">…</Box>                     numbered: consecutive numbered boxes count 1, 2, 3…
 *
 * Plain boxes of the same colour that follow each other stack closely as a group
 * (a list of options); other boxes that follow each other keep a normal gap.
 */
import Rating from './Rating.astro';
import { resolveImage } from '@/lib/images';
import { boxIcons, type BoxIcon } from '@/lib/icons';
import { scaleColors } from '@/lib/colors';

const headerTones = ['red', 'orange', 'yellow', 'green'] as const;

interface Props {
  title?: string;
  /** Makes the title a link */
  href?: string;
  /** Logo image next to the article (or a public path) */
  logo?: string;
  logoAlt?: string;
  /** Icelandic-support score shown top right */
  rating?: number;
  ratingLabel?: string;
  /** Icon next to the title, or "number" to number the box */
  icon?: BoxIcon | 'number' | '';
  /** Small label, e.g. a date or a status */
  chip?: string;
  tone?: 'tint' | 'neutral' | 'outline' | (typeof headerTones)[number];
  /** Heading level for the title */
  level?: 3 | 4 | '3' | '4';
}

const { title, href, logo, logoAlt = '', rating, ratingLabel = 'Íslenskustuðningur', icon, chip, tone = 'tint', level = 3 } = Astro.props;
const Heading = `h${Number(level)}` as 'h3' | 'h4';
const logoImage = logo ? resolveImage(logo, Astro.locals.articleId) : undefined;
const logoSrc = typeof logoImage === 'string' ? logoImage : logoImage?.src;
const headerTone = headerTones.find((t) => t === tone);
const numbered = icon === 'number' && !headerTone;
const iconSvg = icon && icon !== 'number' ? boxIcons[icon]?.svg : undefined;
const style = headerTone ? `--head: ${scaleColors[headerTone].base}` : undefined;
// Plain boxes (no header, icon or number) stack closely with others of the same colour
const plain = !headerTone && !numbered && !iconSvg && tone !== 'outline';
---

<section class:list={['box', headerTone ? 'has-head' : tone, { numbered, plain }]} style={style}>
  {numbered && <span class="number" />}
  {
    headerTone ? (
      <header class="head">
        {title && <Heading class="title">{href ? <a href={href}>{title}</a> : title}</Heading>}
        {chip && <span class="chip">{chip}</span>}
      </header>
    ) : (
      <>
        {(logoSrc || rating) && (
          <div class="top">
            {logoSrc && <img src={logoSrc} alt={logoAlt} class="logo" loading="lazy" />}
            {rating && <Rating label={ratingLabel} value={rating} />}
          </div>
        )}
        {chip && <span class="chip">{chip}</span>}
        {(title || iconSvg) && (
          <div class="heading">
            {iconSvg && (
              <svg class="icon" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={iconSvg} />
            )}
            {title && <Heading class="title">{href ? <a href={href}>{title}</a> : title}</Heading>}
          </div>
        )}
      </>
    )
  }
  <div class="body"><slot /></div>
</section>

<style>
  .box {
    padding: 1.75rem 2rem 2rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--cat-base) 18%, var(--color-bg));
  }

  .neutral {
    background: var(--color-surface);
  }

  .outline {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--cat-base);
  }

  /* Coloured header: a light tint of the scale colour, the body in the surface colour */
  .has-head {
    padding: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.125rem 2rem;
    background: color-mix(in srgb, var(--head) 30%, var(--color-bg));
  }

  .head .title {
    margin: 0;
  }

  .has-head .body {
    padding: 1.5rem 2rem 2rem;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .logo {
    width: auto;
    height: 2.25rem;
    max-width: 10rem;
    object-fit: contain;
  }

  /* Rating alone sits on the right */
  .top:not(:has(.logo)) {
    justify-content: flex-end;
  }

  .chip {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cat-base) 35%, var(--color-bg));
    font-size: var(--body-xs);
    font-weight: 600;
    line-height: 1.35;
  }

  .neutral .chip,
  .outline .chip {
    background: color-mix(in srgb, var(--cat-base) 25%, var(--color-bg));
  }

  .head .chip {
    margin: 0;
    background: rgb(255 255 255 / 0.6);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.625rem;
  }

  .icon {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--cat-text);
  }

  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--body-md);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  /* Numbered: a large numeral beside the content, counted by CSS (see the reset below) */
  .numbered {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    counter-increment: box-number;
  }

  .numbered > :global(*) {
    grid-column: 2;
  }

  .numbered > .number {
    grid-column: 1;
    grid-row: 1 / span 9;
  }

  .number::before {
    content: counter(box-number);
    display: block;
    color: var(--cat-text);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
  }

  /* Any other element in the article starts a new run of numbers, so consecutive
     numbered boxes count 1, 2, 3… and restart after text or other components */
  :global(.prose > :not(.numbered)),
  :global(.columns) {
    counter-reset: box-number;
  }

  .body {
    font-size: 0.9em;
    line-height: 1.5;
  }

  .body > :global(*) {
    margin: 0;
  }

  .body :global(li + li) {
    margin-top: 0.4em;
  }

  /* A box inside a box (e.g. Dálkar in a framing box) keeps its text size */
  .body .body {
    font-size: 1em;
  }

  .body > :global(* + *) {
    margin-top: 1.1em;
  }

  .body :global(h4) {
    margin-top: 1.5em;
    font-size: 1em;
  }

  .body :global(h4 + *) {
    margin-top: 0.35em;
  }

  .body :global(.stat + .stat) {
    margin-top: 0.25em;
  }

  /* Boxes that follow each other in the text: a normal gap… (in Dálkar, the grid spaces them) */
  :global(.prose > .box + .box) {
    margin-top: 1rem !important;
  }

  /* …except plain boxes of the same colour, which stack closely as a group */
  :global(.prose > .box.plain.tint + .box.plain.tint),
  :global(.prose > .box.plain.neutral + .box.plain.neutral) {
    margin-top: var(--gap-tight) !important;
  }
</style>
