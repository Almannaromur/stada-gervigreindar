---
import { categoryVars } from '@/lib/colors';
import { articleUrl, formatDate, isoDate, type Article, type Category } from '@/lib/content';

interface Props {
  article: Article;
  category: Category;
  /** Show the article summary (category pages) */
  excerpt?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { article, category, excerpt = false, headingLevel: Heading = 'h3' } = Astro.props;
---

<a href={articleUrl(article)} class:list={['card', { 'with-excerpt': excerpt }]} style={categoryVars(category.data.color)}>
  <span class="tag">{category.data.name}</span>
  <Heading class="title">{article.data.title}</Heading>
  {excerpt && <p class="excerpt">{article.data.description}</p>}
  <time datetime={isoDate(article.data.date)}>{formatDate(article.data.date)}</time>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 2rem 2.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: background-color 0.15s, box-shadow 0.15s;
  }

  .card:hover {
    background: var(--color-hover);
    box-shadow: var(--shadow-1);
  }

  .tag {
    color: var(--cat-text);
    font-weight: 500;
  }

  .title {
    font-size: var(--h5);
    font-weight: 500;
    letter-spacing: -0.0125em;
  }

  .with-excerpt {
    gap: 0.75rem;
    padding-block: 2.25rem 2.5rem;
  }

  .with-excerpt .title {
    font-weight: 600;
  }

  .excerpt {
    display: -webkit-box;
    max-width: 29rem;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-muted);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  time {
    color: var(--color-text-muted);
  }
</style>
